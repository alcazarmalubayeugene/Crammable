# Crammable — environment variables
# Copy this file to .env.local and fill in real values (never commit .env.local).
# Get the real values from a project maintainer — they are intentionally not in the repo.
# Key names mirror EnvKeys in contracts.ts (see CLAUDE.md §6).

# --- Supabase (public — safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (SERVER ONLY — never expose, never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- DeepSeek (SERVER ONLY) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
